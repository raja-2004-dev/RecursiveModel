<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Views.RecDemoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Views">
    <StackLayout VerticalOptions="FillAndExpand">


        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
            <Image
                x:Name="Arrow"
                Grid.Column="0"
                HeightRequest="20"
                IsVisible="False"
                Source="chevron.png">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Image.GestureRecognizers>
            </Image>
            <Image
                x:Name="ComponentImage"
                Grid.Column="1"
                HeightRequest="20"
                Source="file.png" />
            <Label
                x:Name="Textlabel"
                Grid.Column="2"
                FontSize="15"
                TextColor="Black" />
        </Grid>


        <CollectionView
            x:Name="ComponentsCollectionView"
            Margin="50,0,0,0"
            IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <local:RecDemoView Margin="5" RecursiveModel="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>
</ContentView>
